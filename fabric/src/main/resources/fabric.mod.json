{
  "schemaVersion": 1,
  "id": "mtg",
  "version": "${version}",
  "name": "MTG Base Library",
  "description": "Shared card rules, registries and expansion hooks for independent MTG add-ons.",
  "authors": [
    "LeoYan"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mtg.fabric.FabricMtgMod"
    ],
    "client": [
      "com.mtg.fabric.FabricMtgClientMod"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
